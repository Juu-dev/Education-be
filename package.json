{
  "name": "education-backend",
  "version": "1.0.0",
  "description": "NestJS application for O2 Skin Backend",
  "author": "ColorMe-EDUTO",
  "license": "MIT",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nodemon",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "build": "nest build",
    "prestart:prod": "npm run build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:report": "eslint --output-file eslint_report.json --format json src; exit 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "reset-node-modules": "rm -rf node_modules && yarn"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.688.0",
    "@aws-sdk/s3-request-presigner": "^3.688.0",
    "@nestjs/cache-manager": "^2.1.1",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/common": "^10.2.10",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/testing": "^10.2.10",
    "@prisma/client": "^5.7.0",
    "@smithy/node-http-handler": "^3.2.5",
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.21",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^4.1.0",
    "cache-manager-redis-store": "^2.0.0",
    "chalk": "^5.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "colorette": "^2.0.20",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "education-backend": "file:",
    "express": "^4.17.1",
    "fastify-multer": "^2.0.3",
    "form-data": "^4.0.1",
    "iconv-lite": "^0.6.3",
    "joi": "^17.11.0",
    "kysely": "^0.27.2",
    "lodash": "^4.17.21",
    "module-alias": "^2.2.3",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.8",
    "nestjs-pino": "^4.0.0",
    "node-cron": "^3.0.3",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "pino-http": "^10.3.0",
    "pino-pretty": "^10.3.0",
    "prisma-extension-kysely": "^2.1.0",
    "prisma-kysely": "^1.8.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.0.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cache-manager-redis-store": "^2.0.4",
    "@types/jest": "^27.0.4",
    "@types/node": "^16.11.17",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.33.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "husky": "8.0.3",
    "jest": "^27.4.3",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.0.1",
    "pino-http": "^10.3.0",
    "prisma": "^5.7.0",
    "ts-jest": "^27.0.7",
    "ts-node": "^10.4.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ]
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "ts-node --transpile-only -r tsconfig-paths/register ./src/main.ts",
    "env": {
      "TS_NODE_PROJECT": "./tsconfig.json"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "bash .husky/commit-msg"
    }
  }
}
