// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
  output          = "../node_modules/.prisma/client"
}

generator kysely {
  provider     = "prisma-kysely"
  output       = "../src/database/kysely"
  fileName     = "types.ts"
  enumFileName = "enums.ts"
  camelCase    = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// schema.prisma

model User {
  id        String    @id @default(uuid()) @map("id")
  username  String    @unique @map("username") @db.VarChar(50)
  password  String    @map("password") @db.VarChar(120)
  email     String    @unique @map("email") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  ethnicity String    @default("") @map("ethnicity") @db.VarChar(50)
  gender    String    @default("") @map("gender") @db.VarChar(50)
  phone     String    @default("") @map("phone") @db.VarChar(50)
  name      String    @map("name") @db.VarChar(255)
  birthDate DateTime? @map("birth_date") @db.Timestamp(6)
  classId   String?   @map("class_id") @db.VarChar(36)

  isDeleted Boolean?  @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  librarian Librarian?
  student   Student?
  teacher   Teacher?

  roles        UserRole[]
  document     Document[]
  refreshToken RefreshToken[]
  assignerTask Task[]         @relation("assigner")
  assigneeTask Task[]         @relation("assignee")

  class           Class?            @relation(fields: [classId], references: [id])
  rating          Rating[]
  comment         Comment[]
  documentStudent DocumentStudent[]
  goal            Goal[]
  mark            Mark[]
  request         Request[]
  borrowedLog     BorrowedLog[]
  exercise        Exercise[]
  Answer          Answer[]
  Quiz            Quiz[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @map("id")
  value     String
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Role {
  id        String   @id @default(uuid()) @map("id")
  name      String   @unique @map("name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.VarChar(255)
  roleId String @map("role_id") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Class {
  id        String   @id @default(uuid())
  name      String   @map("name") @db.VarChar(255)
  amount    Int?     @default(0) @map("amount") @db.Integer
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  exercises Exercise[]
  user      User[]

  @@map("classes")
}

model Student {
  id          String   @id @default(uuid()) @map("id")
  userId      String   @unique @map("user_id") @db.VarChar(36)
  metadataUrl String?  @map("metadata_url") @db.VarChar(255)
  parentName  String?  @map("parent_name") @db.VarChar(255)
  level       String?  @map("level") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("students")
}

model Teacher {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id") @db.VarChar(36)
  metadataUrl String?  @map("metadata_url") @db.VarChar(255)
  position    String?  @map("position") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("teachers")
}

model Librarian {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id") @db.VarChar(36)
  metadataUrl String?  @map("metadata_url") @db.VarChar(255)
  position    String?  @map("position") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  // requests Request[]
  @@map("librarians")
}

model Document {
  id          String   @id @default(uuid())
  userId      String   @map("user_id") @db.VarChar(36)
  type        String?  @map("type") @db.VarChar(255)
  description String?  @map("description") @db.Text
  url         String?  @map("url") @db.VarChar(255)
  metadataUrl String?  @map("metadata_url") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id])
  ratings          Rating[]
  comments         Comment[]
  goals            Goal[]
  marks            Mark[]
  documentStudents DocumentStudent[]
  borrowedLog      BorrowedLog[]

  @@map("documents")
}

model Rating {
  id         String   @id @default(uuid())
  documentId String   @map("document_id") @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  star       Int?
  ratedAt    DateTime @map("rated_at") @db.Timestamp(6)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("ratings")
}

model Comment {
  id         String   @id @default(uuid())
  documentId String   @map("document_id") @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  parentId   String?  @map("parent_id") @db.VarChar(36)
  content    String   @map("content") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  // parent   Comment?  @relation(fields: [parentId], references: [id])
  // Comment  Comment[]
  @@map("comments")
}

model DocumentStudent {
  id             String    @id @default(uuid())
  documentId     String    @map("document_id") @db.VarChar(36)
  userId         String    @map("user_id") @db.VarChar(36)
  percentage     Int?
  status         String?   @map("status") @db.VarChar(255)
  marked         Boolean?
  startedTime    DateTime? @map("started_time") @db.Timestamp(6)
  lastAccessTime DateTime? @map("last_access_time") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("document_students")
}

model Goal {
  id          String    @id @default(uuid())
  documentId  String    @map("document_id") @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  description String?   @map("description") @db.Text
  dueDate     DateTime? @map("due_date") @db.Timestamp(6)
  status      String?   @map("status") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("goals")
}

model Mark {
  id         String   @id @default(uuid())
  documentId String   @map("document_id") @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  page       Int?
  markedAt   DateTime @map("marked_at") @db.Timestamp(6)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("marks")
}

model Task {
  id          String    @id @default(uuid())
  title       String    @map("title") @db.VarChar(36)
  status      String?   @map("status") @db.VarChar(255)
  description String?   @map("description") @db.Text
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamp(6)
  type        String?   @map("type") @db.VarChar(255)
  priority    String?   @map("priority") @db.VarChar(255)
  endTime     DateTime? @map("end_time") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  assignerId String @map("assigner_id") @db.VarChar(36)
  assigner   User   @relation("assigner", fields: [assignerId], references: [id])
  assigneeId String @map("assignee_id") @db.VarChar(36)
  assignee   User   @relation("assignee", fields: [assigneeId], references: [id])

  @@map("tasks")
}

model Request {
  id          String   @id @default(uuid())
  librarianId String?  @map("librarian_id") @db.VarChar(36)
  userId      String?  @map("user_id") @db.VarChar(36)
  bookTitle   String?  @map("book_title") @db.VarChar(255)
  description String?  @map("description") @db.Text
  status      String?  @map("status") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // librarian Librarian @relation(fields: [librarianId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@map("requests")
}

model BorrowedLog {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id") @db.VarChar(36)
  documentId String    @map("document_id") @db.VarChar(36)
  borrowDate DateTime  @map("borrow_date") @db.Timestamp(6)
  returnDate DateTime? @map("return_date") @db.Timestamp(6)
  status     String?   @map("status") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  user     User?    @relation(fields: [userId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@map("borrowed_logs")
}

model Book {
  id              String   @id @default(uuid())
  title           String   @db.VarChar(100)
  description     String   @db.VarChar(1000)
  author          String   @db.VarChar(50)
  publishingHouse String   @map("publishing_house") @db.VarChar(50)
  coverImageUrl   String?  @map("cover_image_url") @db.VarChar(255)
  contentPdfUrl   String?  @map("content_pdf_url") @db.VarChar(255)
  type            String?  @map("type") @db.VarChar(255)
  evaluate        Int?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("books")
}

model BookImport {
  id                String   @id @default(uuid())
  title             String   @db.VarChar(100)
  yearOfPublication String   @map("year_of_publication") @db.VarChar(50)
  amount            Int?
  borrowedAmount    Int?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("books_imports")
}

model Exercise {
  id          String   @id @default(uuid())
  name        String   @map("name") @db.VarChar(255)
  description String   @map("description") @db.VarChar(255)
  timeOut     Int      @map("time_out")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  assignerId String @map("assigner_id") @db.VarChar(36)
  assigner   User   @relation(fields: [assignerId], references: [id])

  classAssigneeId String @map("class_assignee_id") @db.VarChar(36)
  classAssignee   Class  @relation(fields: [classAssigneeId], references: [id])

  quizId  String   @map("quiz_id") @db.VarChar(36)
  quiz    Quiz     @relation(fields: [quizId], references: [id])
  answers Answer[]

  @@map("exercises")
}

model Quiz {
  id        String   @id @default(uuid())
  title     String   @map("title") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  creatorId String? @db.VarChar(36)
  creator   User?   @relation(fields: [creatorId], references: [id])

  questions Question[]
  exercise  Exercise[]

  @@map("quizzes")
}

model Question {
  id        String   @id @default(uuid())
  quizId    String?  @map("quiz_id") @db.VarChar(36)
  content   String   @map("content") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  quiz           Quiz?            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options        Option[]
  questionAnswer QuestionAnswer[]

  @@map("questions")
}

model Option {
  id         String   @id @default(uuid())
  questionId String   @map("question_id") @db.VarChar(36)
  content    String   @map("content") @db.Text
  isCorrect  Boolean  @map("is_correct") @db.Boolean
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  question       Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionAnswer QuestionAnswer[]

  @@map("options")
}

model Answer {
  id         String   @id @default(uuid())
  userId     String   @map("user_id") @db.VarChar(36)
  exerciseId String   @map("exercise_id") @db.VarChar(36)
  mark       Float?   @map("mark")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  exercise        Exercise         @relation(fields: [exerciseId], references: [id])
  questionAnswers QuestionAnswer[]

  @@map("answers")
}

model QuestionAnswer {
  id               String   @id @default(uuid())
  answerId         String   @map("answer_id") @db.VarChar(36)
  questionId       String   @map("question_id") @db.VarChar(36)
  selectedOptionId String?  @map("selected_option_id") @db.VarChar(36)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  answer         Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?  @relation(fields: [selectedOptionId], references: [id])

  @@map("question_answers")
}
